{
  "name": "dsh-question-jump-bar",
  "version": "1.3.0",
  "description": "DSH web plugin: conversation interaction layer — select text to add to chat for follow-ups, pencil edit button on user messages to edit & resend, custom user message renderer with expandable quote cards. (The right-edge question navigator rail was retired in v1.3.0: DSH 0.1.2 ships an official turn navigator.)",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "docs/screenshot.png"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.8",
    "react": "^18.2.0"
  },
  "license": "MIT",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "conversation",
    "navigation",
    "jump-bar",
    "reasonix"
  ]
}
